  "_hues": "Plan tile colours, by meaning. bg is the tile, ink the glyph on it, chart the swatch in Finance. 'themed' overrides for the navy look.",
  "hues": {
    "blue":   { "meaning": "getting around",       "bg": "#2F44F5", "ink": "#FFFFFF", "themed": "#4F61FF" },
    "yellow": { "meaning": "food and the home",    "bg": "#FFC81F", "ink": "#11131A", "themed": "#FFD23F" },
    "pink":   { "meaning": "family and giving",    "bg": "#F2427E", "ink": "#FFFFFF", "themed": "#FF5C93" },
    "violet": { "meaning": "rent and housing",     "bg": "#7650F2", "ink": "#FFFFFF", "themed": "#8F70FF" },
    "teal":   { "meaning": "bills and data",       "bg": "#0C93B0", "ink": "#FFFFFF", "themed": "#19B4D6" },
    "orange": { "meaning": "school and staff",     "bg": "#FF8A3D", "ink": "#11131A", "themed": "#FF9A52" },
    "coral":  { "meaning": "health",               "bg": "#E5484D", "ink": "#FFFFFF", "themed": "#FF6B6B" },
    "green":  { "meaning": "savings",              "bg": "#0E9F70", "ink": "#FFFFFF", "themed": "#1DBF8A" },
    "slate":  { "meaning": "you, and everything else", "bg": "#5F6576", "ink": "#FFFFFF", "themed": "#7F87B3" }
  },

  "_plans": "What a plan can be for. A plan stores `emoji` (unchanged, so WhatsApp and emails keep it); the app shows the icon for it. `also` lists older or similar emoji that show the same icon. Order is the order in the picker.",
  "plans": [
    { "key": "upkeep",    "label": "Upkeep",     "emoji": "🍲", "icon": "cooking-pot",      "hue": "yellow", "also": ["🥘", "🍛", "🥗"] },
    { "key": "food",      "label": "Food",       "emoji": "🍔", "icon": "hamburger",        "hue": "yellow", "also": ["🍕", "🍟", "🍗", "🥡"] },
    { "key": "groceries", "label": "Groceries",  "emoji": "🛒", "icon": "shopping-cart",    "hue": "yellow", "also": ["🧺", "🥖", "🍞"] },
    { "key": "fuel",      "label": "Fuel",       "emoji": "⛽", "icon": "gas-pump",         "hue": "blue",   "also": [] },
