    { "key": "giving",    "label": "Giving",     "emoji": "🙏", "icon": "hand-heart",       "hue": "pink",   "also": ["⛪", "🕌", "🎁"], "chart": "#B8336A" },
    { "key": "rent",      "label": "Rent",       "emoji": "🏠", "icon": "house-line",       "hue": "violet", "also": ["🏡", "🏘", "🔑", "🏢"] },
    { "key": "bills",     "label": "Light bill", "emoji": "💡", "icon": "lightning",        "hue": "teal",   "also": ["⚡", "🔌"] },
    { "key": "data",      "label": "Data",       "emoji": "📱", "icon": "device-mobile",    "hue": "teal",   "also": ["📶", "📞", "☎", "🌐", "📺"], "chart": "#086F86" },
    { "key": "school",    "label": "School",     "emoji": "🎓", "icon": "graduation-cap",   "hue": "orange", "also": ["📚", "✏", "🏫", "🎒"] },
    { "key": "staff",     "label": "Staff pay",  "emoji": "👷", "icon": "users-three",      "hue": "orange", "also": ["💂", "🧹", "👥"], "chart": "#C2620F" },
    { "key": "cook",      "label": "Cook",       "emoji": "🧑‍🍳", "icon": "chef-hat",      "hue": "orange", "also": ["🍳", "👩‍🍳", "👨‍🍳"], "chart": "#C2620F" },
    { "key": "health",    "label": "Health",     "emoji": "💊", "icon": "pill",             "hue": "coral",  "also": ["🏥", "🩺", "💉"] },
    { "key": "gym",       "label": "Gym",        "emoji": "💪", "icon": "barbell",          "hue": "coral",  "also": ["🏋", "⚽"] },
