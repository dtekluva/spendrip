# Copy to .env. Never commit real keys.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
SPENDRIP_DEV_TOOLS=true

# Accounts (account numbers + incoming transfers): "mock" (default) or "liberty"
PAYMENT_PROVIDER=mock
# Payouts + account name checks: empty = same as PAYMENT_PROVIDER, or "paystack"
PAYOUT_PROVIDER=

# Paystack: card top-ups (saved cards), and payouts when PAYOUT_PROVIDER=paystack.
# PAYSTACK_MODE picks the keys: "test" (default when DJANGO_DEBUG=true) uses TEST_PAYSTACK_*;
# "live" uses PAYSTACK_* and is refused while SPENDRIP_DEV_TOOLS is on. No key = built-in test checkout.
PAYSTACK_MODE=test
TEST_PAYSTACK_SECRET_KEY=
TEST_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PASS_CARD_FEES=true
# Where the React app lives, so Paystack can send people back after paying
PUBLIC_APP_URL=http://localhost:5173
# Encrypts saved-card tokens. Set a long random value in production and never change it.
FIELD_ENCRYPTION_KEY=
MESSENGER=mock
KYC_PROVIDER=mock

# Liberty Pay Core Banking (only used when PAYMENT_PROVIDER=liberty)
LIBERTY_BASE_URL=https://banking.libertypayng.com
LIBERTY_EMAIL=
LIBERTY_PASSWORD=
LIBERTY_API_KEY=
LIBERTY_SOURCE_ACCOUNT=
LIBERTY_MODE=LIVE

# Money and safety
TRANSFER_FEE_KOBO=5000
LATE_SEND_WINDOW_HOURS=6
WORKER_TICK_SECONDS=30

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.spendrip.com
MAILGUN_API_BASE=https://api.mailgun.net
DEFAULT_FROM_EMAIL=SpenDrip <hello@mg.spendrip.com>

# Check account names with the LIVE Paystack key (PAYSTACK_SECRET_KEY) while cards and payouts stay in test mode.
# Name checks move no money; test mode only allows 3 real-bank checks a day.
PAYSTACK_LIVE_NAME_CHECKS=false

# Live mode
KYC_PROVIDER=mock                 # live = BVN via Paystack, ID photo + selfie read by Claude
ANTHROPIC_API_KEY=
ANTHROPIC_KYC_MODEL=claude-sonnet-5-5
PAYOUTS_ENABLED=true              # false stops every real payout immediately
DEFAULT_DAILY_CAP_KOBO=10000000   # ₦100,000/day for new accounts
BANK_TRANSFER_FUNDING=true        # false = cards only, no account numbers (until Liberty is live)
TIER1_MAX_BALANCE_KOBO=30000000
TIER1_MAX_DRIP_KOBO=5000000
